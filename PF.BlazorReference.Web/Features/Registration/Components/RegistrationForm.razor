@namespace PF.BlazorReference.Web.Features.Registration.Components

@* Presentation component: parameters in, an EventCallback out, nothing injected. *@
<EditForm Model="Model" FormName="@FormName" OnValidSubmit="OnValidSubmit" class="pf-form" novalidate>
    <DataAnnotationsValidator />

    <div class="pf-field">
        <label for="name">Name</label>
        <InputText id="name" @bind-Value="Model.Name" autocomplete="name" />
        <ValidationMessage For="() => Model.Name" />
        @foreach (var message in ServerMessages(nameof(Model.Name)))
        {
            <p class="pf-field-error">@message</p>
        }
    </div>

    <div class="pf-field">
        <label for="email">Email</label>
        <InputText id="email" type="email" @bind-Value="Model.Email" autocomplete="email" />
        <ValidationMessage For="() => Model.Email" />
        @foreach (var message in ServerMessages(nameof(Model.Email)))
        {
            <p class="pf-field-error">@message</p>
        }
    </div>

    <button type="submit" class="pf-button">Register</button>
</EditForm>
