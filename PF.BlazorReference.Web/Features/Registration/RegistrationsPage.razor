@page "/registrations"
@* Interactive for this page only; prerender is off so the data loads once, on the circuit. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using PF.BlazorReference.Web.Features.Registration.Components

<PageTitle>Registrations</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
    <h1>Registrations</h1>
    <MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="Refresh" Disabled="state.Loading" OnClick="LoadAsync" />
</MudStack>

@if (state.Error is not null)
{
    <MudAlert Severity="Severity.Error">@state.Error</MudAlert>
}
else if (state.Loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <RegistrationTable Rows="state.Rows" HighlightId="highlightId"
                       ShowInvite="CanInvite" CurrentRecordProcessingId="currentRecordProcessingId" OnInvite="RequestInvitationAsync" />
}
